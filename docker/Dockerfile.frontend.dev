# Development-only frontend image (Vite HMR)
FROM node:20-alpine

WORKDIR /app

# Copy dependency manifests
COPY frontend/package*.json ./

RUN npm install

# Copy source (will be overridden by volume mount in dev)
COPY frontend/ .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
